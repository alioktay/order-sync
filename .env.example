# HTTP port for the order-sync API.
PORT=3000

# Host port for PostgreSQL.
POSTGRES_PORT=5432

# PostgreSQL database settings used by Docker Compose.
POSTGRES_DB=order_sync
POSTGRES_USER=order_sync
POSTGRES_PASSWORD=replace-with-a-local-password

# PostgreSQL connection string. Use `postgres` as the host for Docker Compose,
# or `localhost` when running the application directly on the host.
DATABASE_URL=postgresql://order_sync:replace-with-a-local-password@postgres:5432/order_sync

# SAP order endpoint URL. Replace this with the interview-provided ngrok URL when needed.
SAP_API_URL=http://mock-sap:4000/api/orders

# Cancellation-window delay for orders containing hardware, in seconds.
HARDWARE_SYNC_DELAY_SECONDS=30

# Timeout for each outgoing SAP request, in milliseconds.
SAP_TIMEOUT_MS=3000

# Number of initial SAP delivery attempts before entering recovery mode.
SAP_ATTEMPTS_BEFORE_WAITING=3

# Hard limit for total SAP delivery attempts, including the initial attempt.
SAP_MAX_ATTEMPTS=5

# Maximum time spent retrying an unavailable SAP endpoint, in seconds.
SAP_RECOVERY_WINDOW_SECONDS=900

# Maximum PostgreSQL listener reconnect backoff, in milliseconds.
SAP_LISTENER_RECONNECT_MAX_MS=1000

# Optional shared secret required in the X-Webhook-Secret header for incoming webhooks.
WEBHOOK_SECRET=
